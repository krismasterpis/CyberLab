<Window x:Class="CyberLab.Resources.Popups.SetpointsPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberLab.Resources.Popups"
        xmlns:converters="clr-namespace:CyberLab.Resources.Converters"
        xmlns:controls="clr-namespace:CyberLab.Resources.Controls"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Setpoints Configuration" Height="550" Width="900"
        Background="#252529" Foreground="#E0E0E0" WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_OnLoaded" Closed="Window_Closed">
    
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
            <GroupBox BorderBrush="#555555" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                <GroupBox.Header>
                    <TextBlock Text="TIME DOMAIN" Foreground="#888888" FontSize="12" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel>
                    <CheckBox x:Name="TimeConstantsCheckedBox" Content="Time constants" Foreground="#CCCCCC" Margin="0,0,0,10"
                              IsEnabled="{Binding ElementName=UserDefinedCheckedBox, Path=IsChecked, Converter={StaticResource InverseBooleanConverter}}"/>
                    <CheckBox x:Name="UserDefinedCheckedBox" Content="User defined" Foreground="#CCCCCC"
                              IsEnabled="{Binding ElementName=TimeConstantsCheckedBox, Path=IsChecked, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox BorderBrush="#555555" BorderThickness="1" Margin="0,0,0,15" Padding="10" 
                      IsEnabled="{Binding ElementName=TimeConstantsCheckedBox, Path=IsChecked}">
                <GroupBox.Header>
                    <TextBlock Text="CONSTANTS" Foreground="#888888" FontSize="12" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="τ heating (s):" VerticalAlignment="Center" Foreground="#CCCCCC"/>
                        <TextBox x:Name="HeatingTextBox" Grid.Column="1" TextChanged="TextBox_TextChanged" Padding="5" Background="#1E1E22" Foreground="#E0E0E0" BorderBrush="#555555"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="τ cooling (s):" VerticalAlignment="Center" Foreground="#CCCCCC"/>
                        <TextBox x:Name="CoolingTextBox" Grid.Column="1" TextChanged="TextBox_TextChanged" Padding="5" Background="#1E1E22" Foreground="#E0E0E0" BorderBrush="#555555"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox BorderBrush="#555555" BorderThickness="1" Margin="0,0,0,15" Padding="10">
                <GroupBox.Header>
                    <TextBlock Text="ADDONS" Foreground="#888888" FontSize="12" FontWeight="Bold"/>
                </GroupBox.Header>
                <StackPanel>
                    <CheckBox x:Name="LoopCheckedBox" Content="Loop mode" IsChecked="{Binding LoopMode}" Foreground="#CCCCCC" Margin="0,0,0,10"
                              IsEnabled="{Binding ElementName=ReverseCheckedBox, Path=IsChecked, Converter={StaticResource InverseBooleanConverter}}"/>
                    <CheckBox x:Name="ReverseCheckedBox" Content="Reverse mode" IsChecked="{Binding ReverseMode}" Foreground="#CCCCCC"
                              IsEnabled="{Binding ElementName=LoopCheckedBox, Path=IsChecked, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <GroupBox Grid.Column="1" Grid.Row="0" BorderBrush="#555555" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <GroupBox.Header>
                <TextBlock Text="SETPOINTS EDITOR" Foreground="#888888" FontSize="12" FontWeight="Bold"/>
            </GroupBox.Header>
            <ScottPlot:WpfPlot Name="WpfPlot1" Background="Transparent"
                               MouseDown="WpfPlot1_OnMouseDown"
                               MouseMove="WpfPlot1_OnMouseMove"
                               MouseUp="WpfPlot1_OnMouseUp"
                               MouseDoubleClick="WpfPlot1_MouseDoubleClick"/>
        </GroupBox>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <controls:IconTile x:Name="checkButt" Background="#3F3F46" FillColor="White" MouseLeftButtonDown="checkButt_MouseLeftButtonDown" Width="40" Height="40" IconWidth="24" IconHeight="24" Margin="0,0,20,0" Padding="8" Cursor="Hand" Icon="M320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM404.4 276.7L324.4 404.7C320.2 411.4 313 415.6 305.1 416C297.2 416.4 289.6 412.8 284.9 406.4L236.9 342.4C228.9 331.8 231.1 316.8 241.7 308.8C252.3 300.8 267.3 303 275.3 313.6L302.3 349.6L363.7 251.3C370.7 240.1 385.5 236.6 396.8 243.7C408.1 250.8 411.5 265.5 404.4 276.8z"/>

                <controls:IconTile x:Name="plusButt" Background="#007ACC" FillColor="White" MouseLeftButtonDown="plusButt_MouseLeftButtonDown" Width="40" Height="40" IconWidth="24" IconHeight="24" Margin="0,0,10,0" Padding="8" Cursor="Hand" Icon="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z"/>

                <controls:IconTile x:Name="minusButt" Background="#D13438" FillColor="White" MouseLeftButtonDown="minusButt_MouseLeftButtonDown" Width="40" Height="40" IconWidth="24" IconHeight="24" Margin="10,0,0,0" Padding="8" Cursor="Hand" Icon="M96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320z"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
