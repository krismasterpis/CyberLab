<Window x:Class="CyberLab.Resources.Popups.OsaCalcPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OSA Trace Calculation" Height="220" Width="380" 
        WindowStartupLocation="CenterOwner"
        Background="#1E1E22" Foreground="#E0E0E0" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border Background="#1E1E22" Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock x:Name="textBlock" Grid.Row="0" Text="Calculation between traces ..." 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       FontWeight="Bold" FontSize="15" Foreground="#007ACC" Margin="0,0,0,10"/>
                       
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="ButtA" Content="A" Click="Button_Click"/>
                <Button x:Name="ButtB" Content="B" Click="Button_Click"/>
                <Button x:Name="ButtC" Content="C" Click="Button_Click"/>
                <Button x:Name="ButtD" Content="D" Click="Button_Click"/>
                <Button x:Name="ButtE" Content="E" Click="Button_Click"/>
                <Button x:Name="ButtF" Content="F" Click="Button_Click"/>
                <Button x:Name="ButtG" Content="G" Click="Button_Click"/>
                <Button x:Name="ButtH" Content="H" Click="Button_Click"/>
                <Button x:Name="ButtI" Content="I" Click="Button_Click"/>
                <Button x:Name="ButtJ" Content="J" Click="Button_Click"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="ButtA2" Content="A" Click="Button_Click"/>
                <Button x:Name="ButtB2" Content="B" Click="Button_Click"/>
                <Button x:Name="ButtC2" Content="C" Click="Button_Click"/>
                <Button x:Name="ButtD2" Content="D" Click="Button_Click"/>
                <Button x:Name="ButtE2" Content="E" Click="Button_Click"/>
                <Button x:Name="ButtF2" Content="F" Click="Button_Click"/>
                <Button x:Name="ButtG2" Content="G" Click="Button_Click"/>
                <Button x:Name="ButtH2" Content="H" Click="Button_Click"/>
                <Button x:Name="ButtI2" Content="I" Click="Button_Click"/>
                <Button x:Name="ButtJ2" Content="J" Click="Button_Click"/>
            </StackPanel>
            
            <Button x:Name="okButt" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Content="OK" Width="80" Height="32" Margin="0,10,0,0" Click="okButt_Click"/>
        </Grid>
    </Border>
</Window>

