<Window x:Class="CyberLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CyberLab.Views"
        xmlns:viewmodels="clr-namespace:CyberLab.ViewModels"
        xmlns:controls="clr-namespace:CyberLab.Resources.Controls"
        mc:Ignorable="d"
        Title="CyberLab - Hardware Control Dashboard" Height="1080" Width="1920"
        Background="#1E1E22" Foreground="#E0E0E0" WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:ThermalChamberViewModel}">
            <views:ThermalChamberView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:OsaViewModel}">
            <views:OsaView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CYBERLAB HARDWARE DASHBOARD" Foreground="#888" FontSize="14" FontWeight="Bold" Margin="10,5,0,15"/>

        <controls:CachedTabControl Grid.Row="1" 
                    ItemsSource="{Binding DeviceViewModels}" 
                    SelectedItem="{Binding SelectedDevice}">

            <controls:CachedTabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TabTitle}" FontSize="14" />
                </DataTemplate>
            </controls:CachedTabControl.ItemTemplate>

            <controls:CachedTabControl.ContentTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,5,0,0">
                        <ContentPresenter Content="{Binding}" />
                    </Border>
                </DataTemplate>
            </controls:CachedTabControl.ContentTemplate>

        </controls:CachedTabControl>
    </Grid>
</Window>