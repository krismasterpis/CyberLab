    <!-- ==================== ICON TILE ==================== -->
    <Style TargetType="{x:Type controls:IconTile}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:IconTile}">
                    <Border x:Name="back" 
                        CornerRadius="8" 
                        Padding="{TemplateBinding Padding}" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0">
                        <Path x:Name="icon" 
                          IsHitTestVisible="False"
                          Width="{TemplateBinding IconWidth}" 
                          Height="{TemplateBinding IconHeight}" 
                          Data="{TemplateBinding Icon}" 
                          Stretch="Uniform" 
                          Fill="{TemplateBinding FillColor}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== OSA TRACE CONTROL ==================== -->
    <Style TargetType="{x:Type controls:OsaTraceControl}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:OsaTraceControl}">
                    <Border x:Name="TraceBorder" Background="#1E1E22" CornerRadius="6" BorderBrush="#38383D" BorderThickness="1" Padding="7,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Color indicator & badge: dark pill with colored border and colored letter -->
                            <Border Grid.Column="0" CornerRadius="4" Background="#28282E" 
                                    BorderBrush="{TemplateBinding TraceColorBrush}" BorderThickness="2" 
                                    Width="22" Height="22" Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding TraceLetter}" 
                                           FontWeight="ExtraBold" FontSize="11" 
                                           Foreground="{TemplateBinding TraceColorBrush}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Trace Title / Info -->
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" 
                                       VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>

                            <!-- Mode Selector ComboBox -->
                            <ComboBox Grid.Column="2" IsEnabled="{TemplateBinding IsSelectionEnabled}" 
                                      x:Name="OsaTraceControl_ComboBox" 
                                      Width="74" Height="24" SelectedIndex="0" 
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                      FontSize="11" Padding="2,1">
                                <ComboBoxItem Content="Blank"/>
                                <ComboBoxItem Content="Write"/>
                                <ComboBoxItem Content="Fix"/>
                                <ComboBoxItem Content="Calculate"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="TraceBorder" Value="#25252B"/>
                            <Setter Property="BorderBrush" TargetName="TraceBorder" Value="#4F4F57"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>